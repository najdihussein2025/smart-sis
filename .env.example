# Copy to .env (never commit .env). Used by docker-compose.yml.

# SQL Server sa password: 8+ chars with upper, lower, digit and symbol.
# Don't use ; or " (it goes inside a connection string).
SA_PASSWORD=Sis_Dev_2026!

# JWT signing key, 32+ characters. Any random string for local dev.
JWT_KEY=local-docker-signing-key-change-me-0123456789

# Ports on your PC
WEB_PORT=3000
API_PORT=5080
DB_PORT=14333

# AI service (only with: docker compose --profile ai up)
AI_SERVICE_KEY=change-me
LLM_API_KEY=
LLM_MODEL=
