@api = http://localhost:5080

### Login as the simulated student
# @name login
POST {{api}}/api/auth/login
Content-Type: application/json

{ "universityId": 3001, "password": "Pass@1234" }

### Who am I
GET {{api}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### Forgot password (reset link is printed in the API console in Development)
POST {{api}}/api/auth/forgot-password
Content-Type: application/json

{ "universityId": 3001 }

### Health
GET {{api}}/health

### ───────────── Admin ─────────────

### Login as the simulated admin
# @name adminLogin
POST {{api}}/api/auth/login
Content-Type: application/json

{ "universityId": 1001, "password": "Pass@1234" }

### Admin: dropdown lists (campuses, departments, majors, rooms, active instructors)
GET {{api}}/api/admin/lookups
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: list terms (newest start date first)
GET {{api}}/api/admin/terms
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: create a term (window times are UTC, ending in Z)
# @name createTerm
POST {{api}}/api/admin/terms
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Spring 2027",
  "startDate": "2027-02-01",
  "endDate": "2027-06-15",
  "enrollStart": "2027-01-18T06:00:00Z",
  "enrollEnd": "2027-01-29T21:00:00Z",
  "addDropStart": "2027-02-01T06:00:00Z",
  "addDropEnd": "2027-02-12T21:00:00Z",
  "isCurrent": false
}

### Admin: get one term
GET {{api}}/api/admin/terms/{{createTerm.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: update a term and make it the current one (the previous current term is unset)
PUT {{api}}/api/admin/terms/{{createTerm.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Spring 2027",
  "startDate": "2027-02-01",
  "endDate": "2027-06-20",
  "enrollStart": "2027-01-18T06:00:00Z",
  "enrollEnd": "2027-01-29T21:00:00Z",
  "addDropStart": "2027-02-01T06:00:00Z",
  "addDropEnd": "2027-02-12T21:00:00Z",
  "isCurrent": true
}

### Admin: search courses (code or name, paged, ordered by code)
GET {{api}}/api/admin/courses?search=csc&page=1&pageSize=20
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: create a course (code "csc401" is stored as "CSC 401"; type is "Major" or "Elective")
# @name createCourse
POST {{api}}/api/admin/courses
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "code": "csc401",
  "name": "Software Engineering",
  "credits": 3,
  "description": "Requirements, design, testing and teamwork on a simulated project.",
  "departmentId": 1,
  "prerequisiteIds": [2],
  "majors": [ { "majorId": 1, "type": "Major" } ]
}

### Admin: get one course with prerequisites and majors
GET {{api}}/api/admin/courses/{{createCourse.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: update a course (replaces both lists; [] clears them)
PUT {{api}}/api/admin/courses/{{createCourse.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "code": "CSC 401",
  "name": "Software Engineering",
  "credits": 4,
  "description": null,
  "departmentId": 1,
  "prerequisiteIds": [2, 3],
  "majors": [ { "majorId": 1, "type": "Elective" } ]
}

### Admin: prerequisite cycle → 409 prerequisite_cycle (seed: CSC 310 → CSC 210 → CSC 101)
PUT {{api}}/api/admin/courses/1
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "code": "CSC 101",
  "name": "Introduction to Programming",
  "credits": 3,
  "description": null,
  "departmentId": 1,
  "prerequisiteIds": [3],
  "majors": [ { "majorId": 1, "type": "Major" } ]
}

### Admin: search users (status = Active | Inactive | All, default Active)
GET {{api}}/api/admin/users?search=demo&role=Student&status=All&page=1&pageSize=20
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: create a student (simulated data only, SR-23)
# @name createStudent
POST {{api}}/api/admin/users
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "universityId": 3002,
  "email": "student3002@smartsis.local",
  "fullName": "Simulated Student Two",
  "phone": null,
  "dateOfBirth": "2005-03-14",
  "role": "Student",
  "initialPassword": "Welcome2027",
  "student": { "majorId": 1, "campusId": 1, "enrollmentDate": "2026-09-01", "maxCreditsOverride": null },
  "instructor": null
}

### Admin: create an instructor
POST {{api}}/api/admin/users
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "universityId": 2002,
  "email": "instructor2002@smartsis.local",
  "fullName": "Simulated Instructor Two",
  "phone": null,
  "dateOfBirth": null,
  "role": "Instructor",
  "initialPassword": "Welcome2027",
  "student": null,
  "instructor": { "departmentId": 1 }
}

### Admin: get one user (works for deactivated users too)
GET {{api}}/api/admin/users/{{createStudent.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: update a user (University ID, role and password don't change)
PUT {{api}}/api/admin/users/{{createStudent.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "email": "student3002@smartsis.local",
  "fullName": "Simulated Student Two",
  "phone": "+961 1 000000",
  "dateOfBirth": "2005-03-14",
  "student": { "majorId": 1, "campusId": 1, "enrollmentDate": "2026-09-01", "maxCreditsOverride": 21 },
  "instructor": null
}

### Admin: deactivate a user (204; the user can no longer log in)
POST {{api}}/api/admin/users/{{createStudent.response.body.$.id}}/deactivate
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### ───────────── Admin: sections ─────────────
# Seed ids: term 1 (current), courses 1 CSC 101 · 2 CSC 210 · 3 CSC 310 · 4 MAT 201,
# rooms 1 B-101 · 2 B-204 · 3 Lab-3, instructor 2 (Demo Instructor). Check with GET /api/admin/lookups if unsure.

### Admin: list sections of a term (filter by termId and / or courseId; search matches course code or name)
GET {{api}}/api/admin/sections?termId=1&page=1&pageSize=20
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: create a section on Saturday (free in the seed) → 201
# @name createSection
POST {{api}}/api/admin/sections
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "courseId": 3,
  "termId": 1,
  "sectionCode": "b",
  "instructorId": 2,
  "capacity": 25,
  "meetings": [
    { "id": null, "dayOfWeek": 6, "startTime": "09:00:00", "endTime": "10:15:00", "roomId": 1, "type": "Lecture" },
    { "id": null, "dayOfWeek": 6, "startTime": "10:30:00", "endTime": "12:30:00", "roomId": 3, "type": "Lab" }
  ]
}

### Admin: get one section with meetings and seats taken
GET {{api}}/api/admin/sections/{{createSection.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Admin: update — keep the first meeting (send its id), drop the lab, add a Thursday-evening meeting
PUT {{api}}/api/admin/sections/{{createSection.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "courseId": 3,
  "termId": 1,
  "sectionCode": "B",
  "instructorId": 2,
  "capacity": 30,
  "meetings": [
    { "id": {{createSection.response.body.$.meetings[0].id}}, "dayOfWeek": 6, "startTime": "09:00:00", "endTime": "10:15:00", "roomId": 2, "type": "Lecture" },
    { "id": null, "dayOfWeek": 4, "startTime": "17:00:00", "endTime": "18:15:00", "roomId": 1, "type": "Lecture" }
  ]
}

### Room clash → 409 room_clash (seeded CSC 101 A uses B-101 on Monday 08:00–09:15)
POST {{api}}/api/admin/sections
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "courseId": 4, "termId": 1, "sectionCode": "B", "instructorId": null, "capacity": 30,
  "meetings": [ { "id": null, "dayOfWeek": 1, "startTime": "08:30:00", "endTime": "09:30:00", "roomId": 1, "type": "Lecture" } ]
}

### Instructor clash → 409 instructor_clash (Lab-3 is free Monday morning, the instructor isn't)
POST {{api}}/api/admin/sections
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "courseId": 4, "termId": 1, "sectionCode": "C", "instructorId": 2, "capacity": 30,
  "meetings": [ { "id": null, "dayOfWeek": 1, "startTime": "08:30:00", "endTime": "09:30:00", "roomId": 3, "type": "Lecture" } ]
}

### Duplicate code → 409 duplicate_section_code (CSC 101 already has section A this term)
POST {{api}}/api/admin/sections
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "courseId": 1, "termId": 1, "sectionCode": "a", "instructorId": null, "capacity": 30,
  "meetings": [ { "id": null, "dayOfWeek": 6, "startTime": "14:00:00", "endTime": "15:00:00", "roomId": 2, "type": "Lecture" } ]
}
