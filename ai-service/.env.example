# Shared secret the .NET API sends in X-Service-Key. Must match AiService:ServiceKey in the API.
SERVICE_KEY=change-me
SIS_API_BASE_URL=http://localhost:5080
# Anthropic API key. Empty = /chat answers 503 and the app shows "the assistant isn't set up yet".
LLM_API_KEY=
# Optional, defaults to claude-opus-5-5
LLM_MODEL=
# Optional: low | medium | high | xhigh | max (default medium)
LLM_EFFORT=
# KnowledgeChunks only (written on /ingest, read when searching). ADO.NET style, e.g.
# Server=127.0.0.1,14333;Database=SmartSis;User Id=sa;Password=...
SQL_CONNECTION_STRING=
